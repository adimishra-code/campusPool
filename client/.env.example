# Copy to client/.env and fill in. Vite reads env from this client/ folder
# (the project root for the frontend), NOT the repo root. Only VITE_-prefixed
# vars are exposed to the browser bundle.

# Backend API + websocket origin.
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Set to "true" to show the "Continue with Google" button. The server must also
# have GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET set (repo-root .env).
VITE_GOOGLE_OAUTH_ENABLED=false

# Optional integrations.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_SITE_VERIFICATION=
VITE_APP_VERSION=1.0.0

# NOTE: GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_CALLBACK_URL are
# BACKEND vars — put them in the repo-root .env, not here. They are read by the
# server (dotenv) and are NOT exposed to the browser.
