# =============================================================================
# CampusPool — PRODUCTION environment template
# Copy to a real .env (never commit it) and fill in the values below.
# Required keys are marked [REQUIRED]; the server refuses to boot without a
# strong JWT_SECRET. Everything else is optional and degrades gracefully.
# =============================================================================

# ---- Core --------------------------------------------------------------------
NODE_ENV=production
PORT=5000
# [REQUIRED] Public URL of the frontend. Must be the EXACT origin (scheme+host
# [+port]) — it drives CORS and the OAuth redirect.
CLIENT_URL=https://app.your-domain.com

# [REQUIRED] MongoDB connection string (e.g. MongoDB Atlas SRV URI).
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxx.mongodb.net/campuspool?retryWrites=true&w=majority
# Only used by docker-compose's bundled mongo (ignore if using Atlas).
MONGO_USER=campuspool
MONGO_PASSWORD=change-me-strong

# [REQUIRED] 64+ hex chars of entropy: `openssl rand -hex 32`.
# Boot fails if missing, weak, or left as the dev default.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Auth-cookie SameSite policy:
#   lax / strict  -> frontend and API share a registrable domain (recommended)
#   none          -> frontend and API on DIFFERENT domains (HTTPS required; add
#                    CSRF tokens — see DEPLOY.md "Cross-site" note).
COOKIE_SAMESITE=lax

# ---- Redis (distributed rate limiting) --------------------------------------
# Set this to enable shared rate limiting across replicas. If unset, limiting
# falls back to per-process in-memory (fine for a single instance).
REDIS_URL=redis://default:PASSWORD@your-redis-host:6379
RATE_LIMIT_REDIS_PREFIX=campuspool:ratelimit

# ---- Rate-limit thresholds (per IP / 15 min unless noted) -------------------
AUTH_RATE_LIMIT=40
LOGIN_RATE_LIMIT=10
PASSWORD_RESET_RATE_LIMIT=5
OTP_VERIFY_RATE_LIMIT=10
OTP_REQUEST_RATE_LIMIT=5

# ---- Email (SMTP) — verification OTPs, password reset, 2FA, support ----------
# Without SMTP, OTPs are NOT emailed (and never echoed in production), so users
# cannot verify their email. Configure this before going live.
APP_NAME=CampusPool
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CampusPool <no-reply@your-domain.com>
SUPPORT_EMAIL=support@your-domain.com

# ---- Google OAuth (optional) -------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.your-domain.com/api/auth/google/callback

# ---- Google Maps (optional; server-side geocoding/directions) ---------------
GOOGLE_MAPS_API_KEY=

# ---- Payments (Razorpay, optional) ------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- SMS (Twilio, optional) — SOS / safety alerts ---------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Pricing / behaviour tuning ---------------------------------------------
BASE_FARE=45
PER_KM_RATE=18
PER_MIN_RATE=2.5
SURGE_MULTIPLIER=1.2
DRIVER_REJECT_TIMEOUT_SECONDS=25
SHARE_TOKEN_EXPIRES_IN=12h
ARRIVAL_GRACE_MINUTES=15
ARRIVAL_SCAN_INTERVAL_SECONDS=60

# ---- Client (Vite) build-time vars ------------------------------------------
# These are baked into the frontend bundle at BUILD time (docker-compose `web`).
VITE_API_URL=https://api.your-domain.com/api
VITE_SOCKET_URL=https://api.your-domain.com
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_OAUTH_ENABLED=
VITE_GOOGLE_SITE_VERIFICATION=
