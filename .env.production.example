# =========================================================================
# CampusPool - Production Environment Template
# =========================================================================
# Copy this file to '.env' at the repository root before deploying to production:
#   cp .env.production.example .env
#
# Fill in all required production secrets. Ensure all third-party integrations 
# are correctly provisioned and configured.
# =========================================================================

NODE_ENV=production
PORT=5000
# The public canonical URL of the frontend client (required for CORS and cookies).
CLIENT_URL=https://app.yourdomain.com
# MongoDB production connection string (e.g. MongoDB Atlas).
MONGO_URI=mongodb+srv://user:secure-password@cluster.mongodb.net/campuspool

# Used by docker-compose to provision the MongoDB root user + connection string (if using self-hosted Compose Mongo).
MONGO_USER=campuspool
MONGO_PASSWORD=change-me-mongo-production

# MUST be a strong, high-entropy 32+ character random hex string in production.
# Generate one using: openssl rand -hex 32
# The server will refuse to start if this is missing or weaker than 32 characters.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Auth-cookie SameSite policy: "lax" or "strict".
# Note: "none" is rejected in production by the boot assertion guard to prevent CSRF.
COOKIE_SAMESITE=lax

# Expiry for external read-only trip-share links
SHARE_TOKEN_EXPIRES_IN=12h

# Rate Limiting configuration (express-rate-limit + Redis)
# Max auth/OTP requests per IP per 15 minutes.
AUTH_RATE_LIMIT=40
# Granular brute-force caps (requests per IP).
LOGIN_RATE_LIMIT=10
PASSWORD_RESET_RATE_LIMIT=5
OTP_VERIFY_RATE_LIMIT=10
OTP_REQUEST_RATE_LIMIT=5

# Redis connection URL (required for multi-replica rate limiting).
REDIS_URL=redis://your-redis-server-url:6379
RATE_LIMIT_REDIS_PREFIX=campuspool:ratelimit

# Support/feedback/bug-report recipient email address.
SUPPORT_EMAIL=support@yourdomain.com
APP_NAME=CampusPool

# Email (Nodemailer SMTP) for sending college verification OTPs (required).
# Use a production SMTP service (e.g. Amazon SES, SendGrid, Mailgun, Postmark).
SMTP_HOST=smtp.yourmailprovider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=CampusPool <no-reply@yourdomain.com>

# Google OAuth (optional). When both client ID and client secret are set, 
# Google authentication features are automatically enabled.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=https://api.yourdomain.com/api/auth/google/callback

# Google Maps API (optional). Real credentials enable routing and live map features.
GOOGLE_MAPS_API_KEY=your-production-google-maps-backend-key

# Twilio SMS for emergency SOS/safety alerts (optional). 
# If unset, alerts are logged to the console instead of triggering SMS delivery.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=your-twilio-phone-number

# Safe-arrival escalation checks configuration
ARRIVAL_GRACE_MINUTES=15
ARRIVAL_SCAN_INTERVAL_SECONDS=60

# -------------------------------------------------------------------------
# Client (Vite) Build-Time Variables
# -------------------------------------------------------------------------
# These variables are baked into the frontend bundle at build time.
# In a Docker-based deployment, they are passed as build arguments.
# -------------------------------------------------------------------------
VITE_API_URL=https://api.yourdomain.com/api
VITE_SOCKET_URL=https://api.yourdomain.com
# Toggle displaying the "Continue with Google" button on the login/signup page.
VITE_GOOGLE_OAUTH_ENABLED=false
# Client-side Google Maps API key (recommended to restrict this key by HTTP referrer).
VITE_GOOGLE_MAPS_API_KEY=your-production-google-maps-browser-key
# Google Search Console site verification code (inserted as a meta tag).
VITE_GOOGLE_SITE_VERIFICATION=your-google-site-verification-token
