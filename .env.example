NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/uber_clone
# Used by docker-compose to provision the MongoDB root user + connection string.
MONGO_USER=campuspool
MONGO_PASSWORD=change-me-mongo
# MUST be a long random string in production (e.g. `openssl rand -hex 32`).
# Required in production: the server refuses to boot if this is missing/weak.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# Auth-cookie SameSite policy: "lax" or "strict" for same-site deploys (frontend
# and API share a registrable domain); "none" (HTTPS-only) for cross-site.
COOKIE_SAMESITE=lax
# Max auth/OTP requests per IP per 15 min (credential-stuffing / OTP-spam guard).
AUTH_RATE_LIMIT=40
# Granular brute-force caps (per IP). Layered on top of per-account lockout.
LOGIN_RATE_LIMIT=10
PASSWORD_RESET_RATE_LIMIT=5
OTP_VERIFY_RATE_LIMIT=10
OTP_REQUEST_RATE_LIMIT=5

# Support / feedback / bug-report inbox.
SUPPORT_EMAIL=adityamishrav820@gmail.com

# Google OAuth (optional). When both are set, "Continue with Google" is enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ---- Client (Vite) build-time vars — consumed by docker-compose `web` build ----
# Real Google Maps key enables the live map hero; without it a styled fallback shows.
VITE_GOOGLE_MAPS_API_KEY=
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
# Set to "true" to show the Google sign-in button (server must also be configured).
VITE_GOOGLE_OAUTH_ENABLED=
# Google Search Console site-verification token (rendered as a meta tag).
VITE_GOOGLE_SITE_VERIFICATION=
# Expiry for external read-only trip-share links
SHARE_TOKEN_EXPIRES_IN=12h
MAP_PROVIDER=mapbox
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_CLIENT_KEY=
# Email (college verification OTP). If unset, OTPs are logged to the server
# console and returned as previewOtp in dev so the flow stays testable.
APP_NAME=CampusPool
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CampusPool <no-reply@campuspool.app>
BASE_FARE=45
PER_KM_RATE=18
PER_MIN_RATE=2.5
SURGE_MULTIPLIER=1.2
DRIVER_REJECT_TIMEOUT_SECONDS=25
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
REDIS_URL=redis://localhost:6379
RATE_LIMIT_REDIS_PREFIX=uberclone:ratelimit
# Twilio SMS for SOS / safety alerts. If unset, messages are logged, not sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Safe-arrival escalation tuning
ARRIVAL_GRACE_MINUTES=15
ARRIVAL_SCAN_INTERVAL_SECONDS=60
