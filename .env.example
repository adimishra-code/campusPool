# =========================================================================
# CampusPool - Development Environment Template
# =========================================================================
# Copy this file to '.env' at the repository root:
#   cp .env.example .env
#
# Fill in the variables below. Sensitive integrations (SMTP, Google Auth, 
# Maps, Twilio) degrade gracefully and fallback to safe development behaviors 
# if their keys are left blank.
# =========================================================================

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/campuspool

# Used by docker-compose to provision the MongoDB root user + connection string.
MONGO_USER=campuspool
MONGO_PASSWORD=change-me-mongo

# Auth JWT configuration.
# In development, a default fallback secret is used if this is empty.
# In production, this MUST be a strong, high-entropy 32+ character random hex string.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Auth-cookie SameSite policy: "lax" or "strict" for same-site deployments 
# (where client and API share a registrable domain like app.example.com and api.example.com).
# Note: "none" is rejected in production by the boot assertion guard.
COOKIE_SAMESITE=lax

# Expiry for external read-only trip-share links
SHARE_TOKEN_EXPIRES_IN=12h

# Rate Limiting configuration (express-rate-limit + Redis)
# Max auth/OTP requests per IP per 15 minutes.
AUTH_RATE_LIMIT=40
# Granular brute-force caps (requests per IP).
LOGIN_RATE_LIMIT=10
PASSWORD_RESET_RATE_LIMIT=5
OTP_VERIFY_RATE_LIMIT=10
OTP_REQUEST_RATE_LIMIT=5

# Redis connection URL. If left commented out or empty, rate limiting falls back to in-memory.
REDIS_URL=redis://localhost:6379
RATE_LIMIT_REDIS_PREFIX=campuspool:ratelimit

# Support/feedback/bug-report recipient email address.
SUPPORT_EMAIL=support@campuspool.app
APP_NAME=CampusPool

# Email (Nodemailer SMTP) for sending college verification OTPs.
# If these are left blank/unset, OTPs are printed to the server console and
# returned as "previewOtp" in developer API responses for easy local testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CampusPool <no-reply@campuspool.app>

# Google OAuth (optional). When both client ID and client secret are set, 
# Google authentication features are automatically enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Google Maps API (optional). Real credentials enable routing and live map features.
# If omitted, map controls degrade gracefully to styled mock components.
GOOGLE_MAPS_API_KEY=

# Twilio SMS for emergency SOS/safety alerts (optional). 
# If unset, alerts are logged to the console instead of triggering SMS delivery.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Safe-arrival escalation checks configuration
ARRIVAL_GRACE_MINUTES=15
ARRIVAL_SCAN_INTERVAL_SECONDS=60

# -------------------------------------------------------------------------
# Client (Vite) Build-Time Variables
# -------------------------------------------------------------------------
# These variables are baked into the frontend bundle at build time.
# In a Docker-based deployment, they are passed as build arguments.
# -------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
# Toggle displaying the "Continue with Google" button on the login/signup page.
VITE_GOOGLE_OAUTH_ENABLED=false
# Client-side Google Maps API key (recommended to restrict this key by HTTP referrer).
VITE_GOOGLE_MAPS_API_KEY=
# Google Search Console site verification code (inserted as a meta tag).
VITE_GOOGLE_SITE_VERIFICATION=
